# Falsify environment contract — copy to .env and fill in locally. NEVER commit .env.
# The secret value is NOT stored here; Falsify reuses the same variables Plan Forge
# already sets on this machine.

# OpenBrain (Corpus memory tier). Reuses your existing machine-level vars.
# Key is a 64-char hex MCP access key — keep it secret, never commit it.
OPENBRAIN_KEY=

# Memory endpoints (the same key authorizes both):
#   Public REST/MCP (portable, used in deployment + REST calls):
OPENBRAIN_REST_BASE=https://brain.planforge.software
#   Private MCP-SSE (Tailscale-only, local dev):
OPENBRAIN_URL=https://openbrain.tailfb4202.ts.net/sse

# Project scope for every memory Falsify reads/writes.
FALSIFY_BRAIN_PROJECT=falsify

# --- Optional Falsify settings (all off or defaulted when unset; see docs/CAPABILITIES.md) ---
# Where sessions, the notebook and outcomes live (default: .falsify in the working directory).
# FALSIFY_DATA_DIR=
# Use a different corpus directory (default: the package's own knowledge/).
# FALSIFY_KNOWLEDGE_DIR=
# 1 = refuse any step after intake that carries no sessionId.
# FALSIFY_REQUIRE_SESSION=1
# JSON of claim-score weight overrides; consensus must stay the smallest weight.
# FALSIFY_WEIGHTS={"consensus":0.05}
# Local web UI port (default 4319).
# FALSIFY_WEB_PORT=4319
# Advisory judge model (any OpenAI-compatible chat endpoint, e.g. a local Ollama). Never changes a verdict.
# FALSIFY_JUDGE_URL=http://127.0.0.1:11434/v1
# FALSIFY_JUDGE_MODEL=qwen2.5:32b
# FALSIFY_JUDGE_KEY=
# Embedding-based knowledge matching (any OpenAI-compatible embeddings endpoint).
# FALSIFY_EMBEDDINGS_URL=http://127.0.0.1:11434/v1
# FALSIFY_EMBEDDINGS_MODEL=nomic-embed-text
# FALSIFY_EMBEDDINGS_KEY=
# FALSIFY_EMBEDDINGS_THRESHOLD=0.65
