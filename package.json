{
  "name": "falsify",
  "version": "0.1.0",
  "description": "A reasoning tool whose core algorithm is the Cycle of Scientific Enterprise. Returns falsifiable hypotheses with explicit test conditions, not plain answers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "falsify-mcp": "dist/src/mcp/server.js",
    "falsify-web": "dist/src/web/server.js",
    "falsify-knowledge": "dist/src/cli/knowledge.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "vitest",
    "lint": "eslint src tests",
    "web": "node dist/src/web/server.js",
    "seed-sync": "node dist/src/cli/seedSync.js",
    "knowledge": "node dist/src/cli/knowledge.js",
    "calibrate": "node dist/src/cli/calibrate.js",
    "calibrate:replication": "node dist/src/cli/calibrateReplication.js",
    "calibrate:judge": "node dist/src/cli/calibrateJudge.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.4"
  }
}
